{
  "name": "doctopus",
  "version": "0.2.0-candidate.7",
  "private": true,
  "description": "Doctopus — beautiful, self-hosted API documentation with an interactive playground and framework integrations.",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "check": "npm run check:versions && npm run format:check && npm run lint && npm run typecheck && npm run test:tooling && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:markdown",
    "lint:js": "eslint . --max-warnings=0",
    "lint:markdown": "node scripts/lint-markdown.mjs",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "build:packages": "node scripts/build-spec-browser-validator.mjs && tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "npm run build && vitest run",
    "build": "npm run build:packages && npm run build:client -w @davidniessen/doctopus-reader && npm run build:client -w @davidniessen/doctopus-studio",
    "dev": "npm run build && node packages/cli/dist/main.js dev examples/demo",
    "demo:pages": "node scripts/build-pages-demo.mjs",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "demo:build": "node packages/cli/dist/main.js build examples/demo",
    "demo:serve": "node packages/cli/dist/main.js serve examples/demo/.doctopus/site --port 3000",
    "test:e2e": "playwright test",
    "test:snippets": "node scripts/test-snippets.mjs",
    "test:go-snippets": "node scripts/test-go-snippets.mjs",
    "test:isolated-builds": "node scripts/test-isolated-builds.mjs",
    "test:java-matrix": "node scripts/test-java-matrix.mjs",
    "release:pack": "node scripts/pack-npm.mjs",
    "test:packages": "node scripts/test-packages.mjs",
    "demo:api": "node scripts/mock-api.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "server": "node apps/server/dist/main.js",
    "test:studio": "node scripts/test-studio.mjs",
    "benchmark": "node --max-old-space-size=1536 scripts/benchmark.mjs",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "test:java-consumers": "node scripts/test-java-consumers.mjs",
    "worker": "node apps/worker/dist/main.js",
    "test:build-worker": "node scripts/test-build-worker.mjs",
    "test:server-container": "node scripts/test-server-container.mjs"
  },
  "devDependencies": {
    "@davidniessen/doctopus-cli": "0.2.0-candidate.7",
    "@davidniessen/doctopus-compiler": "0.2.0-candidate.7",
    "@davidniessen/doctopus-content": "0.2.0-candidate.7",
    "@davidniessen/doctopus-contracts": "0.2.0-candidate.7",
    "@davidniessen/doctopus-domain": "0.2.0-candidate.7",
    "@davidniessen/doctopus-explorer": "0.2.0-candidate.7",
    "@davidniessen/doctopus-node": "0.2.0-candidate.7",
    "@davidniessen/doctopus-plugin-sdk": "0.2.0-candidate.7",
    "@davidniessen/doctopus-reader": "0.2.0-candidate.7",
    "@davidniessen/doctopus-search": "0.2.0-candidate.7",
    "@davidniessen/doctopus-server": "0.2.0-candidate.7",
    "@davidniessen/doctopus-spec": "0.2.0-candidate.7",
    "@davidniessen/doctopus-storage": "0.2.0-candidate.7",
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/hast": "3.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/proxy-from-env": "1.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "conventional-commits-parser": "7.1.3",
    "dompurify": "3.4.17",
    "eslint": "10.13.0",
    "express": "5.3.0",
    "fastify": "5.12.7",
    "globals": "17.13.0",
    "jose": "6.2.13",
    "markdownlint": "0.42.0",
    "monaco-editor": "0.57.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "integrations/node"
  ],
  "overrides": {
    "katex": "0.18.2",
    "dompurify": "3.4.17",
    "body-parser": "2.4.0",
    "re2js": "2.8.7"
  }
}
